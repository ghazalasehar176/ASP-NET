@model Bank_Account.Models.ContactViewModel

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="contact-card shadow">
                <h3 class="text-center mb-4">Contact Us</h3>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-dark" })

                    <div class="form-group mb-3">
                        @Html.LabelFor(m => m.Name)
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Your Name" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-dark" })
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email Address" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-dark"})
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(m => m.Phone)
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Phone Number" })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-dark" })
                    </div>

                    <div class="form-group mb-4">
                        @Html.LabelFor(m => m.Message)
                        @Html.TextAreaFor(m => m.Message, 4, 40,
                        new { @class = "form-control", placeholder = "Your Message" })
                    @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-dark" })
                </div>

                <button type="submit" class="btn btn-light"  w-100%">
                    Send Message
                </button>
                                }
            </div>

            @if(ViewBag.error!=null){
                @ViewBag.error
            }

            @if (ViewBag.success != null)
            {
                <div class="alert alert-success mt-3">@ViewBag.success</div>
            }

            @if (ViewBag.error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.error</div>
            }

        </div>
    </div>
</div>