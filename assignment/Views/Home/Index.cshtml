@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    @if (User.Identity.IsAuthenticated)
    {
        <p>Hello @User.Identity.Name</p>

        @if (User.IsInRole("Admin"))
        {
            <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">
                <h3>Admin Panel</h3>
                <p>This page can access only admin</p>
            </a>
        }

        @if (User.IsInRole("User"))
        {
            <a class="nav-link text-dark" asp-controller="User" asp-action="Index">
                <h3> User Panel</h3>
                <p>Only admin and user can access this page</p>
               </a>
        }

        @if (User.IsInRole("Editor"))
        {
            <a class="nav-link text-dark" asp-controller="Editor" asp-action="Index">
                <h3> Editor Panel</h3>
                <p>only admin and editor can access this page</p>
            </a>
        }

        <a href="@Url.Action("Logout", "Account")">Logout</a>
    }
</div>